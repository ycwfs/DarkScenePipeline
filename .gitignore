__pycache__/
*.pyc
.venv/
# Checkpoints are release-hosted (scripts/download_ckpts.sh) EXCEPT the two the recommended
# configuration needs — those are versioned so a fresh clone runs retinexformer +
# bicubic_x2 + behavior with no download at all. bicubic_x2 has no weights.
ckpts/*
!ckpts/NTIRE.pth
!ckpts/videomamba_t_behavior_32f.pth
# DarkAct-finetuned candidate (see compare/results/DARKACT_REPORT.md): not the shipped
# default (--reco-ckpt behavior is unchanged), opt-in via --reco-ckpt for extreme-dark RGB.
!ckpts/videomamba_t_behavior_32f_darkact.pth
outputs/
*.mp4
tests/assets/*.npy
# ARID v1.5 staged from OpenDataLab (7.5 GB) — fetch it, don't version it
assets/OpenDataLab___Action_Recognition_in_the_Dark/
# Operator packaging artefacts: both zips are rebuilt from platform/ by
# make_operator_zip.sh, and .build_ctx is the staged docker build context.
platform/dist/
platform/.build_ctx/
platform/*.tar.gz
# 9 GB of downloaded data staged here by hand (BaiduPCS-Go + FallDataset.zip). Not part
# of the operator packaging; ignored so `git add platform/` cannot try to hash it (it does,
# and it takes minutes before failing on GitHub's 100 MB file limit).
platform/BaiduPCS-Go-*/
